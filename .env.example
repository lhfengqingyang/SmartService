SMARTSERVICE_ENV=development

POSTGRES_DB=smartservice
POSTGRES_USER=smartservice
POSTGRES_PASSWORD=replace_with_local_password
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://smartservice:replace_with_local_password@127.0.0.1:5432/smartservice
DATABASE_SCHEMA_AI=ai
DATABASE_SCHEMA_BIZ=biz

LLM_PROVIDER=qianwen
QIANWEN_API_KEY=your_qianwen_api_key_here
QIANWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QIANWEN_MODEL=qwen3.7-flash

# Set LLM_PROVIDER=zhipu to use these chat settings instead.
ZHIPU_API_KEY=your_zhipu_api_key_here
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
ZHIPU_MODEL=glm-4.7-flash


DEEPSEEK_API_KEY=your_deepseek_api_key_here

EMBEDDING_API_KEY=your_zhipu_api_key_here
EMBEDDING_BASE_URL=https://open.bigmodel.cn/api/paas/v4
EMBEDDING_MODEL=embedding-3
EMBEDDING_DIMENSIONS=1024

FASTAPI_HOST=127.0.0.1
FASTAPI_PORT=8000

UPLOAD_MAX_SIZE_MB=10
UPLOAD_ALLOWED_EXTENSIONS=.md,.txt
CHUNK_TARGET_SIZE=800
CHUNK_MAX_SIZE=1200
CHUNK_OVERLAP_SIZE=120
